<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CursorAccountSwitcher</AssemblyName>
    <RootNamespace>CursorAccountSwitcher</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>账号切换器</Product>
    <AssemblyTitle>账号切换器</AssemblyTitle>
    <Description>多账号并行运行 Cursor 与 Antigravity</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\app.ico" />
    <Resource Include="assets\logo-256.png" />
    <None Include="assets\icon-preview.png" />
    <None Include="assets\make-icon.ps1" />
  </ItemGroup>

  <!-- 前端界面文件：拷贝到输出目录的 assets\ui 下，供 WebView2 通过虚拟主机加载 -->
  <ItemGroup>
    <Content Include="assets\ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>assets\ui\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
